<UserControl x:Class="NexusFirmware.App.Views.ExtractorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Извлечение прошивок" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Firmware Extractor · анализ контейнеров, sparse/payload, экспорт JSON/CSV. Оригиналы не изменяются."
                       Style="{StaticResource SectionSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel>
                    <TextBox Width="360" Text="{Binding SourcePath}" Margin="0,0,8,6" FontSize="11.5" />
                    <Button Content="Выбрать файл" Command="{Binding PickFileCommand}" Margin="0,0,8,6" />
                    <Button Content="Анализировать" Style="{StaticResource PrimaryButton}" Command="{Binding AnalyzeCommand}" Margin="0,0,8,6" />
                    <Button Content="Извлечь в каталог" Command="{Binding ExtractCommand}" Margin="0,0,8,6" />
                    <Button Content="Экспорт JSON" Command="{Binding ExportJsonCommand}" Margin="0,0,8,6" />
                    <Button Content="Экспорт CSV" Command="{Binding ExportCsvCommand}" Margin="0,0,8,6" />
                    <Button Content="Открыть результат" Command="{Binding OpenOutputCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                    <Button Content="Очистить" Command="{Binding ClearCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                    <CheckBox Content="Вычислять SHA-256" IsChecked="{Binding ComputeHash}" VerticalAlignment="Center" Margin="0,0,0,6" />
                </WrapPanel>
                <TextBlock Text="{Binding Summary}" FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="True" Margin="0,0,0,8"
                                          Header="{Binding Title}">
                                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Key}" Style="{StaticResource Caption}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Предупреждения" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding Warnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource WarningBrush}"
                                                   Margin="0,0,0,4" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Предупреждений нет." Style="{StaticResource Caption}"
                                       Visibility="{Binding HasWarnings, Converter={StaticResource InverseBoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ограничения анализа" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding Limitations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,0,0,4" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
