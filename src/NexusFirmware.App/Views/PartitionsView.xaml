<UserControl x:Class="NexusFirmware.App.Views.PartitionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Разделы" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Partitions Manager · fastboot, /proc/partitions, scatter MediaTek и rawprogram XML Qualcomm"
                       Style="{StaticResource SectionSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel>
                    <ComboBox Width="290" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="DisplayName" Margin="0,0,8,6" />
                    <Button Content="Из fastboot" Command="{Binding LoadFastbootCommand}" Margin="0,0,8,6" />
                    <Button Content="Из распределения разделов Linux (ADB)" Command="{Binding LoadAdbCommand}" Margin="0,0,8,6" />
                    <Button Content="Открыть scatter-файл" Command="{Binding LoadScatterCommand}" Margin="0,0,8,6" />
                    <Button Content="Открыть rawprogram XML" Command="{Binding LoadRawProgramCommand}" Margin="0,0,8,6" />
                    <Button Content="Очистить" Command="{Binding ClearCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}">
                    <Run Text="Устройство: " />
                    <Run Text="{Binding DeviceModeText}" />
                    <Run Text=" · " />
                    <Run Text="{Binding Status}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10">
            <DataGrid ItemsSource="{Binding Partitions}" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Раздел" Binding="{Binding Name}" Width="1.4*" />
                    <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="140" />
                    <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="1.6*" />
                    <DataGridTextColumn Header="Детали" Binding="{Binding Detail}" Width="1.6*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
