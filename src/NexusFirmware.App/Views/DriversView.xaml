<UserControl x:Class="NexusFirmware.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Центр драйверов" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Drivers Center · состояние USB-драйверов, официальные источники, проверка подписи установочных пакетов"
                           Style="{StaticResource SectionSubtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Обновить" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="Диспетчер устройств" Command="{Binding OpenDeviceManagerCommand}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="USB-устройства известных производителей" Style="{StaticResource CardTitle}" />
                        <DataGrid ItemsSource="{Binding Inventory}" MaxHeight="240" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Устройство" Binding="{Binding DeviceName}" Width="1.6*" />
                                <DataGridTextColumn Header="Производитель (VID)" Binding="{Binding VendorHint}" Width="120" />
                                <DataGridTextColumn Header="Служба" Binding="{Binding Service}" Width="140" />
                                <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="100" />
                                <DataGridTextColumn Header="Код проблемы" Binding="{Binding ProblemCode}" Width="100" />
                                <DataGridTextColumn Header="Рекомендация" Binding="{Binding Guidance}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Инструменты платформы" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding ToolchainMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11.5" FontFamily="{StaticResource MonoFont}"
                                                   TextWrapping="Wrap" Margin="0,0,0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Проверка цифровой подписи" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Установочный пакет (exe/msi/inf/zip). Проверка Authenticode через Windows."
                                       Style="{StaticResource Caption}" />
                            <TextBox Text="{Binding InstallerPath}" Margin="0,6,0,6" FontSize="11.5" />
                            <WrapPanel>
                                <Button Content="Выбрать" Command="{Binding PickInstallerCommand}" Margin="0,0,8,0" />
                                <Button Content="Проверить подпись" Command="{Binding VerifySignatureCommand}" Style="{StaticResource PrimaryButton}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding SignatureText}" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="NEXUS не отключает проверку подписи драйверов и не устанавливает драйверы автоматически."
                                       Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Официальные источники драйверов" Style="{StaticResource CardTitle}" />
                        <ItemsControl ItemsSource="{Binding Sources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Vendor}" FontSize="12" FontWeight="SemiBold" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Purpose}" FontSize="12" />
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Открыть" Padding="9,4" FontSize="11"
                                                Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Url}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Безопасная переустановка драйвера" Style="{StaticResource CardTitle}" />
                        <ItemsControl ItemsSource="{Binding Guidance}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11.5" Margin="0,0,0,4" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
