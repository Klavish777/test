<UserControl x:Class="NexusFirmware.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Журналы и диагностика" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Logs &amp; Diagnostics · журнал сессии, отчёты операций и файловые журналы Serilog"
                       Style="{StaticResource SectionSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel>
                    <TextBox Width="280" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Фильтр по тексту или источнику" Margin="0,0,8,6" />
                    <Button Content="Экспорт журнала" Command="{Binding ExportCommand}" Margin="0,0,8,6" />
                    <Button Content="Очистить" Command="{Binding ClearCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                    <Button Content="Обновить отчёты" Command="{Binding RefreshReportsCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                    <Button Content="Каталог отчётов" Command="{Binding OpenReportsFolderCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                    <Button Content="Каталог журналов" Command="{Binding OpenLogsFolderCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Caption}">
                    <Run Text="{Binding EntriesCountText}" />
                    <Run Text=" · " />
                    <Run Text="{Binding Status}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8">
                <ListBox ItemsSource="{Binding EntriesView}" Background="{StaticResource BackgroundBrush}" BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}" />
                                <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Отчёты операций" Style="{StaticResource CardTitle}" />
                    <DataGrid ItemsSource="{Binding Reports}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Операция" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Итог" Binding="{Binding State}" Width="90" />
                            <DataGridTextColumn Header="Режим" Binding="{Binding ModeText}" Width="80" />
                            <DataGridTextColumn Header="Завершено" Binding="{Binding FinishedText}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
