<UserControl x:Class="NexusFirmware.App.Views.SamsungView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Сервис Samsung" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Samsung Service · анализ AP/BL/CP/CSC/HOME_CSC, проверка ревизий загрузчика и подготовка пакета. Протокол Odin не реализован."
                       Style="{StaticResource SectionSubtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Пакет прошивки" Style="{StaticResource CardTitle}" />
                            <WrapPanel>
                                <Button Content="Добавить файлы" Command="{Binding AddFilesCommand}" Margin="0,0,8,6" />
                                <Button Content="Очистить" Command="{Binding ClearFilesCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                                <Button Content="Анализировать" Style="{StaticResource PrimaryButton}" Command="{Binding AnalyzeCommand}" Margin="0,0,0,6" />
                            </WrapPanel>
                            <ListBox ItemsSource="{Binding Files}" Height="90" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Устройство и режим Download" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding DeviceText}" Style="{StaticResource Value}" />
                            <DataGrid ItemsSource="{Binding DownloadModeDevices}" MaxHeight="90" Margin="0,8,0,0" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Устройство" Binding="{Binding DisplayName}" Width="*" />
                                    <DataGridTextColumn Header="Режим" Binding="{Binding ModeText}" Width="150" />
                                    <DataGridTextColumn Header="Драйвер" Binding="{Binding DriverText}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Обновить устройства" Command="{Binding RefreshDownloadDevicesCommand}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            <TextBlock Text="Режим Download определяется только при реальном подключении; прошивка выполняется внешним официальным инструментом."
                                       Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Компоненты пакета" Style="{StaticResource CardTitle}" />
                        <ItemsControl ItemsSource="{Binding Components}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11.5" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Проверки пакета" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding PackageChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Check}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                            <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Проверки относительно устройства" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding DeviceChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Check}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                            <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Порядок передачи внешнему инструменту" Style="{StaticResource Caption}" Margin="0,8,0,4" />
                            <ItemsControl ItemsSource="{Binding ExternalLayout}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontSize="11" FontFamily="{StaticResource MonoFont}"
                                                   TextWrapping="Wrap" Margin="0,0,0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Примечания и ограничения" Style="{StaticResource CardTitle}" />
                        <ItemsControl ItemsSource="{Binding Notes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                               Margin="0,0,0,3" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Сохранить отчёт" Command="{Binding SaveReportCommand}" Margin="0,8,0,0"
                                HorizontalAlignment="Left" Style="{StaticResource GhostButton}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" MaxHeight="180">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Отчёт" Style="{StaticResource CardTitle}" />
                <TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" Background="{StaticResource BackgroundBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
