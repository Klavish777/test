<UserControl x:Class="NexusFirmware.App.Views.FlashingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Станция прошивки" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Flashing Station · план → проверки → подтверждение → выполнение → отчёт. Автоматическая запись не начинается."
                       Style="{StaticResource SectionSubtitle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="1. Устройство и прошивка" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Устройство" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                                      DisplayMemberPath="DisplayName" Margin="0,0,0,10" />
                            <TextBlock Text="Прошивка" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding Packages}" SelectedItem="{Binding SelectedPackage}"
                                      DisplayMemberPath="DisplayName" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Content="Обновить список" Command="{Binding ReloadPackagesCommand}"
                                        Style="{StaticResource GhostButton}" Padding="9,4" FontSize="11.5" Margin="0,0,6,0" />
                                <Button Content="Центр прошивок" Command="{Binding OpenFirmwareCenterCommand}"
                                        Style="{StaticResource GhostButton}" Padding="9,4" FontSize="11.5" Margin="0,0,6,0" />
                                <Button Content="ADB-консоль" Command="{Binding OpenAdbConsoleCommand}"
                                        Style="{StaticResource GhostButton}" Padding="9,4" FontSize="11.5" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="2. Параметры операции" Style="{StaticResource CardTitle}" />
                            <CheckBox Content="Dry Run — только план, без изменения устройства"
                                      IsChecked="{Binding IsDryRun}" IsEnabled="False" />
                            <CheckBox Content="Разрешить изменение устройства (реальная запись)"
                                      IsChecked="{Binding AllowModification}" />
                            <CheckBox Content="Продолжать, если состояние загрузчика неизвестно (рискованно)"
                                      IsChecked="{Binding AllowUnknownBootloader}" />
                            <CheckBox Content="Проверять SHA-256 перед операцией" IsChecked="{Binding VerifyIntegrity}" />
                            <CheckBox Content="Перезагрузить после завершения" IsChecked="{Binding RebootAfter}" />
                            <CheckBox Content="Стереть пользовательские данные (fastboot -w)" IsChecked="{Binding WipeUserData}" />
                            <CheckBox Content="Подтверждаю потерю данных" IsChecked="{Binding ConfirmDataWipe}"
                                      IsEnabled="{Binding WipeUserData}" Margin="18,0,0,0" />
                            <TextBlock Text="Ручное сопоставление образов (файл=раздел, по одному в строке)"
                                       Style="{StaticResource Caption}" Margin="0,8,0,3" />
                            <TextBox Text="{Binding MappingText, UpdateSourceTrigger=PropertyChanged}" Height="54"
                                     AcceptsReturn="True" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     VerticalScrollBarVisibility="Auto" />
                            <TextBlock Text="{Binding ReadOnlyBanner}" Foreground="{StaticResource WarningBrush}"
                                       FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="3. Действия" Style="{StaticResource CardTitle}" />
                            <Button Content="Построить план и проверить условия" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding BuildPlanCommand}" Margin="0,0,0,6" />
                            <Button Content="Запустить Dry Run в очередь" Command="{Binding RunDryRunCommand}" Margin="0,0,0,6" />
                            <Button Content="Выполнить прошивку (с подтверждением)" Style="{StaticResource DangerButton}"
                                    Command="{Binding ExecuteCommand}" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding StrategyText, StringFormat=Стратегия: {0}}" Style="{StaticResource Caption}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding PlanTitle}" Style="{StaticResource CardTitle}" FontSize="15" />
                            <TextBlock Text="{Binding PlanSummary}" Style="{StaticResource Caption}" Margin="0,0,0,10" />

                            <TextBlock Text="Проверки" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding PlanChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="4" CornerRadius="2" Margin="0,0,8,0"
                                                    Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Check}" FontSize="11.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Message}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Предупреждения" Style="{StaticResource CardTitle}" Margin="0,10,0,4" />
                            <ItemsControl ItemsSource="{Binding PlanWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource WarningBrush}"
                                                   TextWrapping="Wrap" Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="План операций" Style="{StaticResource CardTitle}" />
                            <DataGrid ItemsSource="{Binding PlanSteps}" MaxHeight="330" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Шаг" Binding="{Binding Title}" Width="1.2*" />
                                    <DataGridTextColumn Header="Описание" Binding="{Binding Detail}" Width="2*" />
                                    <DataGridTextColumn Header="Риск" Binding="{Binding Risk}" Width="120" />
                                    <DataGridTextColumn Header="Команда" Binding="{Binding Command}" Width="1.2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Команды указаны для прозрачности плана; в режиме Dry Run они не выполняются."
                                       Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Целевые разделы" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding Targets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" FontFamily="{StaticResource MonoFont}"
                                                   Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Если раздел не определён, используйте ручное сопоставление. Неизвестные образы не записываются."
                                       Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
