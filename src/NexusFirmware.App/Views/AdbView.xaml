<UserControl x:Class="NexusFirmware.App.Views.AdbView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="ADB и Fastboot" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="ADB &amp; Fastboot · диагностические команды с проверкой аргументов, тайм-аутами и журналированием"
                       Style="{StaticResource SectionSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <WrapPanel>
                <ComboBox Width="300" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName" Margin="0,0,8,6" />
                <Button Content="Проверить инструменты" Command="{Binding CheckToolsCommand}" Margin="0,0,8,6" />
                <Button Content="Свойства (getprop)" Command="{Binding GetPropsCommand}" Margin="0,0,8,6" />
                <Button Content="Батарея" Command="{Binding BatteryCommand}" Margin="0,0,8,6" />
                <Button Content="logcat (300 строк)" Command="{Binding LogcatCommand}" Margin="0,0,8,6" />
                <Button Content="Reboot → system" Command="{Binding RebootSystemCommand}" Margin="0,0,8,6" />
                <Button Content="Reboot → bootloader" Command="{Binding RebootBootloaderCommand}" Margin="0,0,8,6" />
                <Button Content="Reboot → recovery" Command="{Binding RebootRecoveryCommand}" Margin="0,0,8,6" />
                <Button Content="fastboot getvar all" Command="{Binding FastbootVarsCommand}" Margin="0,0,8,6" />
                <Button Content="Разделы fastboot" Command="{Binding FastbootPartitionsCommand}" Margin="0,0,8,6" />
                <Button Content="Очистить вывод" Command="{Binding ClearOutputCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Margin="0,0,0,6">
                    <Run Text="ADB:" />
                    <Run Text="{Binding AdbVersion}" />
                    <Run Text=" · Fastboot:" />
                    <Run Text="{Binding FastbootVersion}" />
                </TextBlock>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Вывод команды" Style="{StaticResource CardTitle}" />
                    <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="{StaticResource BackgroundBrush}" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Пользовательская команда" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Введите аргументы adb/fastboot. Опасные команды (root, unlock, remount, format, dd) заблокированы."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding CustomCommand, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,6"
                             FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                    <Button Content="Выполнить" Command="{Binding RunCustomCommand}" Margin="0,0,0,10"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                    <Button Content="Перейти в станцию прошивки" Command="{Binding OpenFlashingCommand}"
                            Style="{StaticResource GhostButton}" HorizontalAlignment="Left" />
                    <TextBlock Text="Подтверждение отладки на устройстве не обходится. Приложение не получает скрытый доступ к данным."
                               Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Expander Grid.Column="0" Header="Переменные fastboot" IsExpanded="False">
                <Border Style="{StaticResource Card}" Padding="8">
                    <DataGrid ItemsSource="{Binding FastbootVariables}" MaxHeight="200" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Переменная" Binding="{Binding Label}" Width="*" />
                            <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Expander>

            <Expander Grid.Column="2" Header="Разделы (fastboot)" IsExpanded="False">
                <Border Style="{StaticResource Card}" Padding="8">
                    <DataGrid ItemsSource="{Binding Partitions}" MaxHeight="200" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Раздел" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="120" />
                            <DataGridTextColumn Header="Источник" Binding="{Binding Source}" Width="1.4*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Expander>
        </Grid>
    </Grid>
</UserControl>
