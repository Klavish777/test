<UserControl x:Class="NexusFirmware.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Настройки" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Settings · безопасность, пути к инструментам, лицензирование и обновления"
                       Style="{StaticResource SectionSubtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Безопасность" Style="{StaticResource CardTitle}" />
                            <CheckBox Content="Режим только чтения (запрет записи на устройство)"
                                      IsChecked="{Binding ReadOnlyMode}" />
                            <CheckBox Content="Требовать ввод серийного номера для опасных операций"
                                      IsChecked="{Binding RequireSerialConfirmation}" />
                            <CheckBox Content="Маскировать серийные номера и IMEI в журналах"
                                      IsChecked="{Binding MaskSerials}" />
                            <CheckBox Content="Разрешить загрузку внешних плагинов" IsChecked="{Binding AllowPluginLoading}" />
                            <TextBlock Text="Проверка подписи драйверов Windows не отключается приложением."
                                       Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Интерфейс и обнаружение" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Язык (RU / EN)" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Margin="0,0,0,10" />
                            <TextBlock Text="Период автообновления списка устройств, сек (0 — выключено)"
                                       Style="{StaticResource Caption}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding RefreshSeconds}" Width="120" HorizontalAlignment="Left" />
                            <TextBlock Text="Часть подписей интерфейса доступна на английском через словарь Localizer; основной язык — русский."
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Пути и инструменты" Style="{StaticResource CardTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="adb.exe" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AdbPath}" Margin="0,4" FontSize="11.5" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Обзор" Command="{Binding BrowseAdbCommand}" Margin="8,4,0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="fastboot.exe" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FastbootPath}" Margin="0,4" FontSize="11.5" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Обзор" Command="{Binding BrowseFastbootCommand}" Margin="8,4,0,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Библиотека прошивок" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LibraryRoot}" Margin="0,4" FontSize="11.5" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Обзор" Command="{Binding BrowseLibraryCommand}" Margin="8,4,0,4" />
                        </Grid>
                        <TextBlock Text="Если пути не заданы, используется поиск в NEXUS_PLATFORM_TOOLS, ANDROID_HOME, PATH и стандартных каталогах Android SDK."
                                   Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Лицензирование" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Локальный ключ" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding LicenseKey}" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding LicenseNotes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,0,0,3" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Обновления" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Канал" Style="{StaticResource Caption}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding UpdateChannel}"
                                      Width="160" HorizontalAlignment="Left" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Content="Проверить обновления" Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,0" />
                                <Button Content="Страница проекта" Command="{Binding OpenProjectsPageCommand}" Style="{StaticResource GhostButton}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock Text="Автоматическая установка обновлений не выполняется: приложение только сообщает о релизе."
                                       Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Данные приложения" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding DataDirectory, StringFormat=Каталог: {0}}" Style="{StaticResource Caption}"
                                   FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DatabasePath, StringFormat=База: {0}}" Style="{StaticResource Caption}"
                                   FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LogsDirectory, StringFormat=Журналы: {0}}" Style="{StaticResource Caption}"
                                   FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding BuildInfo}" Style="{StaticResource Caption}"
                                   FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Открыть каталог данных" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                            <Button Content="Сбросить настройки" Command="{Binding ResetCommand}" Style="{StaticResource GhostButton}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource CardTight}" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="Сохранить настройки" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
