<UserControl x:Class="NexusFirmware.App.Views.FirmwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Центр прошивок" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="Firmware Center · импорт файлов, SHA-256, метаданные, совместимость и сравнение сборок"
                       Style="{StaticResource SectionSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardTight}" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel>
                    <TextBox Width="230" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Поиск по файлу, модели, версии, SHA-256" Margin="0,0,8,6" />
                    <ComboBox Width="160" ItemsSource="{Binding Manufacturers}"
                              SelectedItem="{Binding SelectedManufacturer}" Margin="0,0,8,6" />
                    <Button Content="Импорт файла" Style="{StaticResource PrimaryButton}" Command="{Binding ImportFileCommand}" Margin="0,0,8,6" />
                    <Button Content="Импорт каталога" Command="{Binding ImportFolderCommand}" Margin="0,0,8,6" />
                    <Button Content="Проверить SHA-256" Command="{Binding VerifyHashCommand}" Margin="0,0,8,6" />
                    <Button Content="Совместимость с устройством" Command="{Binding CheckCompatibilityCommand}" Margin="0,0,8,6" />
                    <Button Content="Удалить запись" Command="{Binding RemoveCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                    <Button Content="Обновить" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,6" />
                </WrapPanel>
                <Grid>
                    <TextBlock Text="{Binding ImportStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BusyText}" HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}"
                               FontSize="11.5" />
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                    <Run Text="{Binding CountText}" />
                    <Run Text=" · " />
                    <Run Text="{Binding FreeSpaceText}" />
                    <Run Text=" · каталог: " />
                    <Run Text="{Binding LibraryRoot}" FontFamily="{StaticResource MonoFont}" />
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <DataGrid ItemsSource="{Binding PackagesView}" SelectedItem="{Binding SelectedPackage}"
                          SelectionMode="Single" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Файл" Binding="{Binding DisplayName}" Width="2*" />
                        <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="110" />
                        <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="100" />
                        <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="130" />
                        <DataGridTextColumn Header="Формат" Binding="{Binding FormatText}" Width="120" />
                        <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" Width="90" />
                        <DataGridTextColumn Header="Целостность" Binding="{Binding IntegrityText}" Width="140" />
                        <DataGridTextColumn Header="Импорт" Binding="{Binding ImportedAt, StringFormat=yyyy-MM-dd}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <ScrollViewer Grid.Row="0" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Сведения о сборке" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding Details}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Открыть каталог прошивок" Command="{Binding OpenFolderCommand}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            <Button Content="Перейти в станцию прошивки" Command="{Binding OpenFlashingCommand}"
                                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Совместимость" Style="{StaticResource CardTitle}" />
                            <ItemsControl ItemsSource="{Binding CompatibilityChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,5">
                                            <TextBlock Text="{Binding Check}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                            <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Проверка выполняется относительно выбранного в верхней панели устройства."
                                       Style="{StaticResource Caption}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Заметки к сборке" Style="{StaticResource CardTitle}" />
                            <TextBox Text="{Binding NoteDraft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     Height="54" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            <Button Content="Добавить заметку" Command="{Binding AddNoteCommand}" Margin="0,6,0,8"
                                    HorizontalAlignment="Left" Style="{StaticResource GhostButton}" />
                            <ItemsControl ItemsSource="{Binding Notes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Text="{Binding CreatedText}" Style="{StaticResource Caption}" />
                                            <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Expander Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Header="Сравнение двух сборок"
                      Margin="0,10,0,0" IsExpanded="False">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <WrapPanel>
                            <TextBlock Text="Слева:" VerticalAlignment="Center" Margin="0,0,6,6" Style="{StaticResource Caption}" />
                            <ComboBox Width="260" ItemsSource="{Binding AllPackages}" SelectedItem="{Binding LeftPackage}"
                                      DisplayMemberPath="DisplayName" Margin="0,0,12,6" />
                            <TextBlock Text="Справа:" VerticalAlignment="Center" Margin="0,0,6,6" Style="{StaticResource Caption}" />
                            <ComboBox Width="260" ItemsSource="{Binding AllPackages}" SelectedItem="{Binding RightPackage}"
                                      DisplayMemberPath="DisplayName" Margin="0,0,12,6" />
                            <Button Content="Сравнить" Command="{Binding CompareCommand}" Margin="0,0,0,6" />
                        </WrapPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DataGrid Grid.Column="0" ItemsSource="{Binding ComparisonRows}" MaxHeight="240" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Свойство" Binding="{Binding Property}" Width="120" />
                                    <DataGridTextColumn Header="Слева" Binding="{Binding Left}" Width="*" />
                                    <DataGridTextColumn Header="Справа" Binding="{Binding Right}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Только слева" Style="{StaticResource Caption}" />
                                <ListBox ItemsSource="{Binding OnlyInLeft}" Height="90" Margin="0,4,0,8" />
                                <TextBlock Text="Различия размеров" Style="{StaticResource Caption}" />
                                <ListBox ItemsSource="{Binding SizeDifferences}" Height="90" Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="Только справа" Style="{StaticResource Caption}" />
                                <ListBox ItemsSource="{Binding OnlyInRight}" Height="90" Margin="0,4,0,8" />
                                <TextBlock Text="Примечания" Style="{StaticResource Caption}" />
                                <ListBox ItemsSource="{Binding ComparisonNotes}" Height="90" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>
        </Grid>
    </Grid>
</UserControl>
