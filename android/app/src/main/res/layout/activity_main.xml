<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1115"
    android:orientation="vertical">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#12161D">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">

            <Button
                android:id="@+id/tabDay"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#2F6FEB"
                android:minWidth="92dp"
                android:text="День"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/tabAttract"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#171A21"
                android:minWidth="104dp"
                android:text="Привлечь"
                android:textAllCaps="false"
                android:textColor="#E6E8EE"
                android:textSize="13sp" />

            <Button
                android:id="@+id/tabGrow"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#171A21"
                android:minWidth="92dp"
                android:text="Рост"
                android:textAllCaps="false"
                android:textColor="#E6E8EE"
                android:textSize="13sp" />

            <Button
                android:id="@+id/tabActivity"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#171A21"
                android:minWidth="112dp"
                android:text="Активность"
                android:textAllCaps="false"
                android:textColor="#E6E8EE"
                android:textSize="13sp" />

            <Button
                android:id="@+id/tabPlan"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#171A21"
                android:minWidth="92dp"
                android:text="План"
                android:textAllCaps="false"
                android:textColor="#E6E8EE"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:id="@+id/panelDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dayHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#171A21"
                    android:lineSpacingExtra="3dp"
                    android:padding="14dp"
                    android:textColor="#E6E8EE"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/routineList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/rulesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#12161D"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:textColor="#9AA3B2"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelAttract"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/attractTopic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#171A21"
                    android:hint="О чём ролик"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="#E6E8EE"
                    android:textColorHint="#5A6273"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/attractPlatform"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#171A21"
                    android:popupBackground="#171A21" />

                <Spinner
                    android:id="@+id/attractNiche"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#171A21"
                    android:popupBackground="#171A21" />

                <Spinner
                    android:id="@+id/attractTone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#171A21"
                    android:popupBackground="#171A21" />

                <Button
                    android:id="@+id/attractBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#2F6FEB"
                    android:text="Крючки, заголовки, хэштеги"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/attractCollabBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#171A21"
                    android:text="Кому написать для коллаборации"
                    android:textAllCaps="false"
                    android:textColor="#E6E8EE" />

                <TextView
                    android:id="@+id/attractOut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#171A21"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:textColor="#E6E8EE"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/attractCopy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#171A21"
                    android:text="Скопировать"
                    android:textAllCaps="false"
                    android:textColor="#E6E8EE"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/attractShare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#3FBF7F"
                    android:text="Поделиться"
                    android:textAllCaps="false"
                    android:textColor="#0B0D11"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelGrow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Spinner
                    android:id="@+id/growPlatform"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#171A21"
                    android:popupBackground="#171A21" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/growSubs"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#171A21"
                        android:hint="Подписчики"
                        android:inputType="number"
                        android:padding="12dp"
                        android:textColor="#E6E8EE"
                        android:textColorHint="#5A6273"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/growViews"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="#171A21"
                        android:hint="Просмотры"
                        android:inputType="number"
                        android:padding="12dp"
                        android:textColor="#E6E8EE"
                        android:textColorHint="#5A6273"
                        android:textSize="14sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/growAdd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#2F6FEB"
                    android:text="Сохранить снимок"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/growSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#12161D"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:textColor="#9AA3B2"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/growList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelActivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Spinner
                    android:id="@+id/activityType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#171A21"
                    android:popupBackground="#171A21" />

                <EditText
                    android:id="@+id/activityTopic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#171A21"
                    android:hint="О чём пост (необязательно)"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="#E6E8EE"
                    android:textColorHint="#5A6273"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/activityNiche"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#171A21"
                    android:popupBackground="#171A21" />

                <Spinner
                    android:id="@+id/activityPlatform"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#171A21"
                    android:popupBackground="#171A21" />

                <Button
                    android:id="@+id/activityBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#2F6FEB"
                    android:text="Собрать тексты"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/activityOut"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#171A21"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:textColor="#E6E8EE"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/activityCopy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#171A21"
                    android:text="Скопировать"
                    android:textAllCaps="false"
                    android:textColor="#E6E8EE"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/activityShare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#3FBF7F"
                    android:text="Поделиться"
                    android:textAllCaps="false"
                    android:textColor="#0B0D11"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/planTopic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#171A21"
                    android:hint="Тема ролика"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="#E6E8EE"
                    android:textColorHint="#5A6273"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/planPlatform"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#171A21"
                    android:popupBackground="#171A21" />

                <EditText
                    android:id="@+id/planDay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#171A21"
                    android:hint="Дата ГГГГ-ММ-ДД"
                    android:inputType="date"
                    android:padding="12dp"
                    android:textColor="#E6E8EE"
                    android:textColorHint="#5A6273"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/planAdd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#2F6FEB"
                    android:text="Добавить в план"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/planSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#12161D"
                    android:padding="12dp"
                    android:textColor="#9AA3B2"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/planList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="22dp"
                    android:background="#252A34" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Цифры ролика"
                    android:textColor="#9AA3B2"
                    android:textSize="12sp"
                    android:textAllCaps="true" />

                <EditText
                    android:id="@+id/statName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="#171A21"
                    android:hint="Название ролика"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="#E6E8EE"
                    android:textColorHint="#5A6273"
                    android:textSize="15sp" />

                <Spinner
                    android:id="@+id/statPlatform"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#171A21"
                    android:popupBackground="#171A21" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/statViews"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#171A21"
                        android:hint="Просмотры"
                        android:inputType="number"
                        android:padding="12dp"
                        android:textColor="#E6E8EE"
                        android:textColorHint="#5A6273"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/statLikes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="#171A21"
                        android:hint="Лайки"
                        android:inputType="number"
                        android:padding="12dp"
                        android:textColor="#E6E8EE"
                        android:textColorHint="#5A6273"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/statComments"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#171A21"
                        android:hint="Комм."
                        android:inputType="number"
                        android:padding="12dp"
                        android:textColor="#E6E8EE"
                        android:textColorHint="#5A6273"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/statShares"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="#171A21"
                        android:hint="Репосты"
                        android:inputType="number"
                        android:padding="12dp"
                        android:textColor="#E6E8EE"
                        android:textColorHint="#5A6273"
                        android:textSize="14sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/statAdd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#2F6FEB"
                    android:text="Сохранить цифры"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/statSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#12161D"
                    android:lineSpacingExtra="4dp"
                    android:padding="14dp"
                    android:textColor="#9AA3B2"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/statList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
